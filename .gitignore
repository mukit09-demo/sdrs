# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# backend
*/gradlew*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
__pycache__/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# IDE — per-developer state, not project configuration
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Local data stores: content edited in the CMS (repo root, shared by both apps)
# and CMS accounts including password hashes (manage-web/.data/users.json).
# Any depth — never commit either.
.data/
