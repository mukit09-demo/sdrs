<?xml version="1.0" encoding="UTF-8"?>
<!--
  Markets — the sectors the practice works in.
  market_featured_project holds plain slugs with no foreign key to project:
  the read path already drops references it cannot resolve, and an FK would
  stop the CMS saving a market that names a project not yet created.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="003-market-01-create-market" author="sdrs">
        <createTable tableName="market">
            <column name="slug" type="varchar(160)">
                <constraints primaryKey="true" primaryKeyName="pk_market" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="tagline" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(600)"/>
            <column name="image_alt" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
            <column name="image_seed" type="varchar(160)"/>
            <column name="film_video_url" type="varchar(600)"/>
            <column name="film_video_embed_url" type="varchar(600)"/>
            <column name="film_video_alt" type="varchar(300)"/>
            <column name="film_video_captions_url" type="varchar(600)"/>
            <column name="film_poster_url" type="varchar(600)"/>
            <column name="film_poster_alt" type="varchar(300)"/>
            <column name="film_poster_seed" type="varchar(160)"/>
            <column name="film_caption" type="varchar(600)"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-market-02-create-market-capability" author="sdrs">
        <createTable tableName="market_capability">
            <column name="market_slug" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="capability" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="market_capability" columnNames="market_slug, position"
                       constraintName="pk_market_capability"/>

        <addForeignKeyConstraint baseTableName="market_capability" baseColumnNames="market_slug"
                                 referencedTableName="market" referencedColumnNames="slug"
                                 constraintName="fk_market_capability_owner" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="003-market-03-create-market-stat" author="sdrs">
        <createTable tableName="market_stat">
            <column name="market_slug" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="stat_value" type="varchar(60)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="varchar(40)"/>
            <column name="label" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="market_stat" columnNames="market_slug, position"
                       constraintName="pk_market_stat"/>

        <addForeignKeyConstraint baseTableName="market_stat" baseColumnNames="market_slug"
                                 referencedTableName="market" referencedColumnNames="slug"
                                 constraintName="fk_market_stat_owner" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="003-market-04-create-market-featured-project" author="sdrs">
        <createTable tableName="market_featured_project">
            <column name="market_slug" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="project_slug" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="market_featured_project" columnNames="market_slug, position"
                       constraintName="pk_market_featured_project"/>

        <addForeignKeyConstraint baseTableName="market_featured_project" baseColumnNames="market_slug"
                                 referencedTableName="market" referencedColumnNames="slug"
                                 constraintName="fk_market_featured_project_owner" onDelete="CASCADE"/>

        <createIndex tableName="market_featured_project" indexName="idx_market_featured_project_project_slug">
            <column name="project_slug"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
