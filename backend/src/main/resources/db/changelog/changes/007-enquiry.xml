<?xml version="1.0" encoding="UTF-8"?>
<!--
  Submitted contact-form enquiries — the only table an
  unauthenticated caller writes to. An inbox, not content.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="007-enquiry-01-create-enquiry" author="sdrs">
        <createTable tableName="enquiry">
            <column name="reference" type="varchar(40)">
                <constraints primaryKey="true" primaryKeyName="pk_enquiry" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="organisation" type="varchar(200)"/>
            <column name="topic" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="received_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="enquiry" indexName="idx_enquiry_received_at">
            <column name="received_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
