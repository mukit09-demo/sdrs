<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jobs.

  The table is `job`, not `job_opening`, because it holds every job — drafts and
  withdrawn roles included. An "opening" is the subset that is advertised right
  now, which is a query:

      status = 'OPEN' and (deadline is null or deadline >= current_date)

  Nothing flips OPEN to CLOSED when a deadline expires. That would need a
  scheduled sweep, and between the deadline and the sweep the database would be
  advertising a role nobody can apply for. Deriving it is never stale.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="006-job-01-create-job" author="sdrs">
        <comment>deadline is nullable because "open until filled" is a real
            case, not missing data.</comment>

        <createTable tableName="job">
            <column name="id" type="varchar(60)">
                <constraints primaryKey="true" primaryKeyName="pk_job" nullable="false"/>
            </column>
            <column name="title" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
            <column name="discipline" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="varchar(160)">
                <constraints nullable="false"/>
            </column>
            <column name="employment_type" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="posted_at" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="deadline" type="date"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-job-02-job-check-constraints" author="sdrs">
        <comment>A deadline before the posting date is always a typo. The status
            values are JobStatus's constants, not its labels.</comment>

        <sql>
            alter table job
                add constraint job_status_known
                check (status in ('DRAFT', 'OPEN', 'CLOSED'));

            alter table job
                add constraint job_deadline_after_posted
                check (deadline is null or deadline &gt;= posted_at);
        </sql>

        <rollback>
            <sql>
                alter table job drop constraint job_deadline_after_posted;
                alter table job drop constraint job_status_known;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="006-job-03-create-job-indexes" author="sdrs">
        <comment>Covers the visibility predicate the candidate-facing list runs
            on every request, and the newest-first ordering.</comment>

        <createIndex tableName="job" indexName="idx_job_status_deadline">
            <column name="status"/>
            <column name="deadline"/>
        </createIndex>

        <createIndex tableName="job" indexName="idx_job_posted_at">
            <column name="posted_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
