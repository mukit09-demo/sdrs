<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console plus a rolling file.

  Single profile, so there are no <springProfile> blocks: a deployment changes
  SDRS_LOG_DIR and SDRS_LOG_LEVEL_ROOT rather than selecting a different
  appender set. Both appenders are always on — the console is what `docker logs`
  and `./gradlew bootRun` show, the file is what survives a restart.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="sdrs-api"/>

    <property name="LOG_DIR" value="${SDRS_LOG_DIR:-logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${appName}.log</file>

        <!--
          Rolls on whichever comes first: a new day, or 10MB. Size matters as
          well as time because one bad afternoon can produce more than a day's
          worth of log, and a 2GB file is not greppable.
        -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <!-- Hard ceiling, so the disk cannot fill no matter the volume. -->
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${SDRS_LOG_LEVEL_ROOT:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
