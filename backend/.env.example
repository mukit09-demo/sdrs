## Copy to `.env` and adjust — that file is gitignored.
##
## Nothing here is loaded automatically: Spring Boot reads the environment, not
## a .env file. Export it before running, e.g.
##
##   set -a && . ./.env && set +a && ./gradlew bootRun
##
## Every variable has a working local default in application.properties except
## SDRS_ADMIN_PASSWORD, which has none on purpose — see below.

## --- Database ---------------------------------------------------------------
# Matches docker-compose.yml, so these three can stay as they are locally.
# Note the non-default port: 5432 is too often already taken by another
# project's Postgres.
SDRS_DB_URL=jdbc:postgresql://localhost:15432/sdrs
SDRS_DB_USERNAME=sdrs
SDRS_DB_PASSWORD=sdrs

## --- Redis ------------------------------------------------------------------
SDRS_REDIS_HOST=localhost
SDRS_REDIS_PORT=16379
SDRS_REDIS_PASSWORD=

# How long a cached read lives. Keep in step with CONTENT_REVALIDATE_SECONDS in
# core-web/.env.example and manage-web/.env.example, or the two cache layers
# disagree about how stale a page may be and the longer one quietly wins.
SDRS_CACHE_TTL=5m

## --- The write credential ---------------------------------------------------
# GET /api/** is public, because core-web is a public website with no credential
# to present. POST, PUT and DELETE require this account.
#
# There is no default password. Unset, the application refuses to start — the
# alternative is a backend that boots fine and accepts anonymous writes, which
# is a worse failure because nothing reports it.
SDRS_ADMIN_USERNAME=admin
SDRS_ADMIN_PASSWORD=

## --- Migrations -------------------------------------------------------------
# Which Liquibase contexts to run. The bundled nine-article news seed is tagged
# `seed`, so leave this alone for local work and set it to `!seed` on an
# environment that has real content.
SDRS_LIQUIBASE_CONTEXTS=seed

## --- Service ----------------------------------------------------------------
SDRS_PORT=3004
SDRS_LOG_DIR=logs
SDRS_LOG_LEVEL_ROOT=INFO
SDRS_LOG_LEVEL_APP=INFO
