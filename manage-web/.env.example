## Copy to `.env.local` and adjust — that file is gitignored, so it stays on
## your machine and is never deployed. This file is the checked-in record of
## which variables a local run needs; it is not loaded by the app itself.
##
## As in core-web, `PORT` is not here: Next boots its HTTP server before reading
## an env file. The port lives in `package.json` — `npm run dev` binds 3003.
##
## Every `NEXT_PUBLIC_*` value is inlined into the bundle at `next build` time
## and frozen there, so a deployed environment has to supply them before the
## build runs. The admin secrets below are deliberately *not* `NEXT_PUBLIC_*`:
## they are read on the server, at request time.

## --- Content ----------------------------------------------------------------

# Where content comes from. Must match core-web, or the two apps disagree.
#   mock -> the shared JSON store, seeded from packages/shared/data
#   api  -> the Spring Boot backend
NEXT_PUBLIC_CONTENT_SOURCE=mock

# Base URL the HTTP repository calls. Leave as /api to go through the rewrite in
# next.config.ts (no CORS configuration needed on the Spring Boot side).
NEXT_PUBLIC_API_BASE_URL=/api

# Spring Boot origin that /api/* is proxied to. Only needed while
# NEXT_PUBLIC_API_BASE_URL is relative.
BACKEND_ORIGIN=http://localhost:3004

# Seconds before cached API responses are revalidated.
CONTENT_REVALIDATE_SECONDS=300

# The content this app writes. Relative to this app's directory, so it points at
# one file at the repo root shared with core-web. Only used while
# NEXT_PUBLIC_CONTENT_SOURCE=mock; with the backend live, writes go to Spring
# Boot and this is ignored.
CONTENT_STORE_PATH=../.data/content.json

## --- This app ---------------------------------------------------------------

# The public site, for the single "View site" link in the header. Two separate
# services, so this cannot be derived from this app's own origin.
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3002

## --- Sign-in ----------------------------------------------------------------

# Where CMS accounts live while NEXT_PUBLIC_CONTENT_SOURCE=mock. Inside this app
# rather than at the repo root on purpose: core-web has no business being able to
# read a file of password hashes. Written with 0600 permissions.
USER_STORE_PATH=.data/users.json

# The bootstrap account, used only to seed an empty account store — without it a
# fresh install has no way to sign in and therefore no way to create the first
# account. Once accounts exist these are ignored: changing them does not change a
# stored account. Delete the store to get the bootstrap account back.

ADMIN_USERNAME=admin

# scrypt hash of the password, never the password itself. Generate it with:
#   node scripts/hash-admin-password.mjs 'the password you want'
# and paste the whole ADMIN_PASSWORD_HASH=... line the script prints.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Generate with `openssl rand -base64 32`. Changing it
# signs everyone out, which is the quickest way to revoke a session.
SESSION_SECRET=

# How long a sign-in lasts. Optional, defaults to 12.
#
# Note for production smoke tests: the session cookie is marked `Secure` when
# NODE_ENV=production, so it will not come back over plain http. `npm run start`
# on http://localhost therefore cannot sign in — use `npm run dev`, or serve the
# production build over https.
ADMIN_SESSION_HOURS=12
