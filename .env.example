## Copy to `.env.local` and adjust — that file is gitignored, so it stays on
## your machine and is never deployed. This file is the checked-in record of
## which variables a local run needs; it is not loaded by the app itself.
##
## Note what is NOT here: the port. `PORT` cannot be set from an env file at
## all, because Next boots the HTTP server before it reads one. The port lives
## in `package.json` instead — `npm run dev` binds 3002 via `next dev -p 3002`.
##
## On a deployed environment these are set by the host, not by a file. Remember
## that every `NEXT_PUBLIC_*` value is inlined into the bundle at `next build`
## time and frozen there, so the host has to supply them before the build runs.

# Where editorial content comes from.
#   mock -> bundled dummy data in src/data (default, no backend needed)
#   api  -> the Spring Boot backend, via src/lib/content/http.repository.ts
NEXT_PUBLIC_CONTENT_SOURCE=mock

# Base URL the HTTP repository calls. Leave as /api to go through the dev
# rewrite below (no CORS configuration needed on the Spring Boot side), or set
# an absolute origin such as https://api.example.com to call it directly.
NEXT_PUBLIC_API_BASE_URL=/api

# Public origin of this site. Used for `metadataBase` in src/app/layout.tsx and
# to resolve relative API URLs during server rendering, where fetch requires an
# absolute URL. This does not bind the port — it only tells the app which origin
# it is being served on, so keep it in step with the port `npm run dev` uses.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Spring Boot origin that /api/* is proxied to (see next.config.ts rewrites).
# Only needed while NEXT_PUBLIC_API_BASE_URL is relative.
BACKEND_ORIGIN=http://localhost:8080

# Seconds before cached API responses are revalidated. Server-side only.
CONTENT_REVALIDATE_SECONDS=300
